@echo off
chcp 65001 >nul
echo ============================================================
echo  [手动启动] 多店数据导出 %date% %time%
echo ============================================================
echo.
echo  说明：
echo   1. 手动触发，不接影刀定时
echo   2. 鉴权过期时人工决定是否重抓
echo   3. 退出码: 0=成功 / 1=部分失败 / 2=鉴权过期(需RPA重抓) / 3=错误
echo.
echo ============================================================
cd /d "%~dp0"

REM 跳过 Cookie 过期检查 + 启用 AuthLoader
set AUTH_SKIP_COOKIE_EXPIRE_CHECK=1
set AUTH_LOADER=1
set AUTH_RPA_CLI=0

REM 跑全部 3 个店（按近 30 天拉，缺日补齐）
python rpa_run.py

echo.
echo ============================================================
echo  [DONE] 退出码 = %ERRORLEVEL%
echo    0=全部成功 / 1=部分失败 / 2=鉴权过期（手动触发 RPA 重抓）
echo ============================================================
pause