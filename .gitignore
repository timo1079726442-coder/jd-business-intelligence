# 敏感信息
# 商智独立 Cookie（与京麦/京准通不互通，项目1/4/5/6/13；2026-08-11 重命名 cookie.txt → sz_cookie.txt）
config/sz_cookie.txt

# 2026-08-14：RPA 中间文件（影刀 ↔ Python 通信，监听结果 JSON 临时存放）
rpa_temp/
# 2026-08-14：RPA 辅助脚本（影刀调用的 .bat 批处理，封装 Python 调用）
rpa_*.bat
config/cookie.txt.bak
# 京准通独立 Cookie（与商智不互通，项目7）
config/jzt_cookie.txt
config/新建文本文档.txt
# 京麦订单导出 IMAP 配置（含 QQ 邮箱授权码，2026-08-11 项目14 阶段5）
config/imap_config.ini
# 京麦订单导出独立 Cookie（与商智不互通，项目14 阶段5）
config/jm_cookie.txt
# 2026-08-12 多店铺支持（项目17 启动）：所有店铺子目录里的鉴权文件全部不入仓
config/*/sz_cookie.txt
config/*/jzt_cookie.txt
config/*/jm_cookie.txt
config/*/h5st.txt
config/*/imap_config.ini
# 2026-08-13 多店铺 JSON 鉴权（项目18 AuthLoader，影刀 RPA 写入）
config/*/sz_cookie.json
config/*/jzt_cookie.json
config/*/jm_cookie.json
config/*/h5st.json

# Excel 临时锁文件 + 副本（防止误提交）
~$*.xlsx
~$*.xls
~$*.doc
~$*.docx
*.xlsx.bak

# 输出和日志
output/
logs/

# CDP 抓包产物（可能含敏感 Cookie + 体积大）
cdp_network_log.json
cdp_user_data/

# SQLite 数据库（含店铺配置 + h5st 抓取记录）
# 2026-08-12：shops.db不入仓（用户决策：每个开发者本地重新生成）
config/shops.db

# Python缓存
__pycache__/
*.pyc
*.pyo

# 测试和临时文件
test_*.py
_test_*.py        # 2026-08-09 补充：下划线开头的临时测试脚本不入仓
check_*.py
find_*.py
analyze_*.py
git_*.py
create_*.py
!create_config_xlsx.py  # 但保留配置文件生成脚本

# 2026-08-09 明确指定：京准通测试脚本不入仓（防止 git glob 漏匹配）
/_test_jzt_kuaiche.py

# 临时HTML
test_*.html
*.html
!docs/*.html

# 抓包JS文件（太大且敏感）
*.js
!jd_api/*.py

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
