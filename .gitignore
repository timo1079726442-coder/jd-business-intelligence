# 敏感信息
# 商智独立 Cookie（与京麦/京准通不互通，项目1/4/5/6/13；2026-08-11 重命名 cookie.txt → sz_cookie.txt）
config/sz_cookie.txt

# 2026-08-14：RPA 中间文件（影刀 ↔ Python 通信，监听结果 JSON 临时存放）
rpa_temp/
# 2026-08-14：RPA 辅助脚本（影刀调用的 .bat 批处理，封装 Python 调用）
rpa_*.bat
config/cookie.txt.bak
# 京准通独立 Cookie（与商智不互通，项目7）
config/jzt_cookie.txt
config/新建文本文档.txt
# 京麦订单导出 IMAP 配置（含 QQ 邮箱授权码，2026-08-11 项目14 阶段5）
config/imap_config.ini
# 京麦订单导出独立 Cookie（与商智不互通，项目14 阶段5）
config/jm_cookie.txt
# 2026-08-12 多店铺支持（项目17 启动）：所有店铺子目录里的鉴权文件全部不入仓
config/*/sz_cookie.txt
config/*/jzt_cookie.txt
config/*/jm_cookie.txt
config/*/h5st.txt
config/*/imap_config.ini
# 2026-08-13 多店铺 JSON 鉴权（项目18 AuthLoader，影刀 RPA 写入）
config/*/sz_cookie.json
config/*/jzt_cookie.json
config/*/jm_cookie.json
config/*/h5st.json
# 2026-08-14 3域独立 h5st JSON（项目20，敏感鉴权，禁止入仓）
config/*/h5st_*.json
# 2026-08-15 现场拼音命名鉴权文件（jm_dingdan / jm_shouhou 对应订单/售后业务，CDP日志格式）
config/*/jm_dingdan_*.json
config/*/jm_shouhou_*.json
# 2026-08-17 多店铺 {{短前缀}}_* 平铺命名鉴权文件（影刀 RPA 输出格式，含 Cookie/h5st，敏感！）
config/{{*}}_*.json
config/{{*}}_*.txt
# 2026-08-22 多店铺平铺命名鉴权文件（项目17/18 演化格式：FYA_jzt_cookie.json / MIYO_sz_cookie.json 等）
#    ⚠️ 防止 git add . 误提交 Cookie/h5st 到远程仓库
config/FYA_*_cookie.json
config/FYA_*_h5st.json
config/MIYO_*_cookie.json
config/MIYO_*_h5st.json
config/OTA_*_cookie.json
config/OTA_*_h5st.json
# 2026-08-14 影刀 CDP 浏览器数据目录（含 Cookie/登录数据，敏感，禁止入仓）
browser_data/

# Excel 临时锁文件 + 副本（防止误提交）
~$*.xlsx
~$*.xls
~$*.doc
~$*.docx
*.xlsx.bak
* - 副本.xlsx
* - 副本.xls

# 输出和日志
output/
logs/

# 项目21 数据目录（2026-08-14 新增）：SQLite DB 运行时动态生成，不入仓
data/

# CDP 抓包产物（可能含敏感 Cookie + 体积大）
