# -*- coding: utf-8 -*-
"""
config/imap_config.ini.example
============================================================
京麦订单明细【加密】导出 - IMAP 配置模板（项目14 阶段5，2026-08-11）

使用步骤：
    1. 复制本文件为 config/imap_config.ini（**不要提交真实值到 git**）
       Windows: copy config\imap_config.ini.example config\imap_config.ini
    2. 填入你的 QQ 邮箱账号 + IMAP 授权码
       授权码获取路径：QQ 邮箱网页版 → 设置 → 账户 → POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务
       → 开启 IMAP/SMTP 服务 → 生成授权码（16 位字符）
    3. 验证：python main.py --biz_key "京麦订单明细_完整一键导出" --date 2026-08-10 --h5st "<h5st>"

⚠️ 业务背景（与 jd-api-analyze SKILL.md 项目14 阶段5 一致）：
    - iPhone 快捷指令监听京东商家短信（接收号 1366794）
    - 收到后自动转发到 QQ 邮箱（带 taskId / password 等结构化内容）
    - Python 脚本用 IMAP 协议拉邮件，按 taskId 精确匹配 → 拿解压密码
    - 密码取到后用 zipfile 解密 zip → 提取 xlsx 订单报表

⚠️ iPhone 快捷指令配置（关键）：
    - 触发条件：收到短信「发送方=京东商家平台/京东」+「正文含 taskId 数字串」
    - 转发动作：发邮件到 user 配置的 QQ 邮箱
    - 邮件主题模板：「[京东] 订单导出解压密码 - taskId 105874710541」
    - 邮件正文模板：「您的导出任务 105874710541 解压密码为：AbCd1234
                     请妥善保管，不要泄露给他人」
    - 主题里含 subject_keyword（默认"解压密码"），正文里含 taskId
    - 满足这两点，Python IMAP 监听就能精确匹配
============================================================
"""

[imap]
# QQ 邮箱 IMAP 服务器（固定）
host = imap.qq.com

# IMAP SSL 端口（固定 993）
port = 993

# 你的 QQ 邮箱账号
user = your_qq@qq.com

# QQ 邮箱 IMAP 授权码（**不是 QQ 密码**，去邮箱设置生成）
# 16 位字符示例：abcdefghijklmnop
auth_code = YOUR_IMAP_AUTH_CODE_HERE

# 是否使用 SSL（QQ 邮箱必须 true）
use_ssl = true

# 邮箱文件夹（一般用 INBOX 收件箱）
folder = INBOX

# 发件人过滤（按需填，京东商家平台发件人可能变化，建议先留空观察邮件来源再填）
# 实证：iPhone 快捷指令转发后，发件人是你的 QQ 邮箱自己（不是 jd.com）
# 所以这里留空匹配所有发件人，靠 subject_keyword + body taskId 精筛
sender_filter =

# 邮件主题关键词（IMAP 搜索时用，越精确越快）
# 用户决策 2026-08-11：iPhone 快捷指令固定主题"京东密码转发"
subject_keyword = 京东密码转发

# IMAP 监听超时（秒），超过此时间未找到密码邮件就退出
# 用户决策 2026-08-11：超时后保留 zip + 提示人工 --sms-password 重跑
max_wait_seconds = 300

# IMAP 轮询间隔（秒），每 N 秒搜索一次新邮件
poll_interval_seconds = 5
